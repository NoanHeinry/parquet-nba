#!/data/data/com.termux/files/usr/bin/bash
# Commande « parquet » pour Termux (Android) : Parquet tourne entièrement sur le téléphone.
#
#   parquet                lance Parquet et l'ouvre dans le navigateur (ou l'ouvre s'il tourne déjà)
#   parquet demo           lance Parquet en mode démonstration
#   parquet stop           arrête Parquet
#   parquet maj            met Parquet à jour
#   parquet diagnostic     teste l'accès à NBA.com et à Wikipédia
#   parquet verifier       vérifie en détail chaque source (format des données compris)
#   parquet serveur        serveur permanent : Wi-Fi, relance et mises à jour automatiques après les tests
#   parquet demarrage oui  relance « parquet serveur » à chaque démarrage du téléphone (Termux:Boot)
#   parquet code XXXXXX    demande ce code aux autres appareils (« parquet code aucun » pour l'enlever)
#   parquet tunnel JETON   publie Parquet à ton adresse Cloudflare avec le serveur (« parquet tunnel aucun »)
#
# Installée par installer-android.sh dans $PREFIX/bin.

set -u
APP="${PARQUET_DIR:-$HOME/parquet-nba}"
PORT="${PARQUET_PORT:-8765}"
URL="http://localhost:$PORT/"
PY="${PARQUET_PYTHON:-$APP/.venv/bin/python}"
ACCES_FILE="$HOME/.parquet-acces"
TUNNEL_FILE="$HOME/.parquet-tunnel"
if [ -z "${PARQUET_ACCES:-}" ] && [ -f "$ACCES_FILE" ]; then
  PARQUET_ACCES="$(cat "$ACCES_FILE")"
  export PARQUET_ACCES
fi

running() {
  python - "$URL" <<'PY' 2>/dev/null
import json, sys, urllib.error, urllib.request
try:
    with urllib.request.urlopen(sys.argv[1] + "api/status", timeout=2) as r:
        sys.exit(0 if "version" in json.load(r)["data"] else 1)
except urllib.error.HTTPError as e:  # protégé par un code d'accès : il tourne quand même
    sys.exit(0 if (e.headers.get("Server") or "").startswith("Parquet") else 1)
except Exception:
    sys.exit(1)
PY
}

open_url() {
  if command -v termux-open-url >/dev/null 2>&1; then
    termux-open-url "$URL"
  else
    echo "Ouvre $URL dans ton navigateur."
  fi
}

need_app() {
  if [ ! -f "$APP/run.py" ] || [ ! -x "$PY" ]; then
    echo "Parquet n'est pas installé dans $APP."
    echo "Relance l'installation : voir docs/GUIDE-UTILISATEUR.md, section « Sans ordinateur »."
    exit 1
  fi
}

start() {
  need_app
  if running; then
    echo "Parquet tourne déjà : ouverture de $URL"
    open_url
    exit 0
  fi
  # Empêche Android de mettre Termux en veille tant que Parquet tourne.
  command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock
  # Ouvre le navigateur dès que le serveur répond.
  (
    for _ in $(seq 1 40); do
      if running; then open_url; exit 0; fi
      sleep 0.5
    done
  ) &
  opener=$!
  trap 'kill "$opener" 2>/dev/null; command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock' EXIT
  cd "$APP" || exit 1
  "$PY" run.py --no-browser --port "$PORT" --port-fixe "$@"
}

# Téléphone serveur : Parquet ouvert au Wi-Fi, sans navigateur, gardé éveillé.
serve() {
  need_app
  if running; then
    echo "Parquet tourne déjà. Pour le relancer en mode serveur : parquet stop, puis parquet serveur."
    exit 0
  fi
  command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock
  cd "$APP" || exit 1
  echo "Mode serveur : laisse le téléphone branché sur le secteur, Termux ouvert en arrière-plan."
  tunnel_pid=""
  if [ -f "$TUNNEL_FILE" ]; then
    if [ -z "${PARQUET_ACCES:-}" ]; then
      echo "Tunnel Cloudflare non lancé : mets d'abord un code d'accès (parquet code MonCodeSecret)."
    elif ! command -v cloudflared >/dev/null 2>&1; then
      echo "Tunnel Cloudflare non lancé : cloudflared manque (pkg install cloudflared)."
    else
      # Le jeton passe par l'environnement, pas par la ligne de commande (visible des autres programmes).
      TUNNEL_TOKEN="$(cat "$TUNNEL_FILE")" cloudflared tunnel --no-autoupdate run > "$HOME/parquet-tunnel.log" 2>&1 &
      tunnel_pid=$!
      echo "Tunnel Cloudflare lancé : Parquet est aussi à ton adresse Cloudflare (journal : ~/parquet-tunnel.log)."
    fi
  fi
  # Mises à jour automatiques (après les tests GitHub) et relance en cas d'arrêt, sauf PARQUET_AUTO_MAJ=0.
  auto="--auto-maj"
  [ "${PARQUET_AUTO_MAJ:-1}" = "0" ] && auto=""
  if [ -z "$tunnel_pid" ]; then
    exec "$PY" run.py --no-browser --port "$PORT" --port-fixe --lan $auto "$@"
  fi
  trap 'kill "$tunnel_pid" 2>/dev/null' EXIT
  "$PY" run.py --no-browser --port "$PORT" --port-fixe --lan $auto "$@"
}

tunnel() {
  case "${1:-}" in
    "")
      if [ -f "$TUNNEL_FILE" ]; then echo "Tunnel Cloudflare : configuré (« parquet tunnel aucun » pour l'enlever)."
      else echo "Tunnel Cloudflare : aucun. Pour en mettre un : parquet tunnel JETON (voir le guide, « Une adresse à toi »)."; fi
      ;;
    aucun|non|off)
      rm -f "$TUNNEL_FILE"
      echo "Tunnel retiré. Relance Parquet (parquet stop, puis parquet serveur)."
      ;;
    *)
      if [ -z "${PARQUET_ACCES:-}" ]; then
        echo "Avec une adresse publique, n'importe qui pourrait ouvrir ton Parquet."
        echo "Mets d'abord un code d'accès : parquet code MonCodeSecret"
        exit 2
      fi
      # Cloudflare affiche une commande entière : on accepte de la recoller telle quelle et on garde le jeton.
      token=""
      for word in "$@"; do
        case "$word" in eyJ*) token="$word" ;; esac
      done
      if [ -z "$token" ]; then
        echo "Je ne trouve pas le jeton : c'est le long texte qui commence par « eyJ » dans la commande donnée par Cloudflare."
        exit 2
      fi
      if ! command -v cloudflared >/dev/null 2>&1; then
        echo "Installation de cloudflared…"
        pkg install -y cloudflared </dev/null || { echo "Installation impossible : tape « pkg install cloudflared », puis recommence."; exit 1; }
      fi
      (umask 077 && printf '%s' "$token" > "$TUNNEL_FILE")
      echo "Jeton enregistré. Relance Parquet (parquet stop, puis parquet serveur) : le tunnel démarrera avec lui,"
      echo "y compris au démarrage du téléphone si « parquet demarrage oui » est activé."
      ;;
  esac
}

BOOT="$HOME/.termux/boot/parquet-serveur"

boot() {
  case "${1:-}" in
    oui|on)
      mkdir -p "$HOME/.termux/boot"
      cat > "$BOOT" <<'SH'
#!/data/data/com.termux/files/usr/bin/sh
# Lancé par Termux:Boot au démarrage du téléphone (créé par « parquet demarrage oui »).
termux-wake-lock
exec parquet serveur > "$HOME/parquet-serveur.log" 2>&1
SH
      chmod 700 "$BOOT"
      echo "C'est noté : Parquet démarrera en mode serveur avec le téléphone."
      echo "Il faut l'application Termux:Boot (F-Droid, même source que Termux), ouverte une fois."
      echo "Pense aussi à retirer Termux de l'optimisation de la batterie (Paramètres > Applications > Termux)."
      ;;
    non|off)
      rm -f "$BOOT"
      echo "Parquet ne démarrera plus avec le téléphone."
      ;;
    *)
      if [ -f "$BOOT" ]; then echo "Démarrage automatique : activé (parquet demarrage non pour l'enlever)."
      else echo "Démarrage automatique : désactivé (parquet demarrage oui pour l'activer)."; fi
      ;;
  esac
}

case "${1:-}" in
  ""|start|lancer)
    [ $# -gt 0 ] && shift
    start "$@"
    ;;
  demo)
    shift
    start --demo "$@"
    ;;
  stop|arreter|arrêter)
    pkill -TERM -f "cloudflared tunnel --no-autoupdate run" 2>/dev/null
    if pkill -TERM -f "run.py --no-browser --port $PORT" 2>/dev/null; then
      echo "Parquet est arrêté."
    else
      echo "Parquet ne tournait pas."
    fi
    command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock
    ;;
  maj|update)
    need_app
    cd "$APP" || exit 1
    git pull --ff-only && "$PY" -m pip install --disable-pip-version-check -q -r requirements.txt && echo "Parquet est à jour."
    # La commande elle-même peut avoir changé. Remplacement par renommage : le fichier en cours
    # d'exécution n'est jamais modifié sur place (bash le lit au fur et à mesure).
    cp "$APP/android/parquet" "$PREFIX/bin/.parquet.new" && chmod 755 "$PREFIX/bin/.parquet.new" \
      && mv -f "$PREFIX/bin/.parquet.new" "$PREFIX/bin/parquet"
    ;;
  serveur|server)
    shift
    serve "$@"
    ;;
  demarrage|démarrage|boot)
    boot "${2:-}"
    ;;
  tunnel)
    shift
    tunnel "$@"
    ;;
  code)
    if [ -z "${2:-}" ]; then
      if [ -f "$ACCES_FILE" ]; then echo "Code d'accès : activé (« parquet code aucun » pour l'enlever)."
      else echo "Code d'accès : aucun. Pour en mettre un : parquet code MonCodeSecret"; fi
    elif [ "$2" = "aucun" ]; then
      rm -f "$ACCES_FILE"
      echo "Code d'accès retiré. Relance Parquet (parquet stop, puis parquet serveur)."
    elif [ "${#2}" -lt 6 ]; then
      echo "Le code doit faire au moins 6 caractères."
      exit 2
    else
      (umask 077 && printf '%s' "$2" > "$ACCES_FILE")
      echo "Code d'accès enregistré. Relance Parquet (parquet stop, puis parquet serveur) pour l'appliquer."
    fi
    ;;
  diagnostic)
    need_app
    cd "$APP" && "$PY" run.py --diagnostic
    ;;
  verifier|vérifier)
    need_app
    cd "$APP" && "$PY" run.py --verifier
    ;;
  -h|--help|aide)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "Commande inconnue : $1 (tape « parquet aide »)"
    exit 2
    ;;
esac
